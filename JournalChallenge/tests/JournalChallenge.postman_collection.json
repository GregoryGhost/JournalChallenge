{
	"info": {
		"_postman_id": "8c4d334e-7b7e-4b4e-9b9e-9b9e9b9e9b9e",
		"name": "JournalChallenge Integration Tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "stt-001: Tree & Node Lifecycle",
			"item": [
				{
					"name": "Get/Create Tree",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.environment.set(\"rootNodeId\", jsonData.id);",
									"}",
									"pm.test(\"Tree has a name\", function () {",
									"    pm.expect(jsonData.name).to.eql(pm.environment.get(\"treeName\"));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.get"
							],
							"query": [
								{
									"key": "treeName",
									"value": "{{treeName}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Root Node (if empty)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set(\"rootNodeId\", jsonData.id);",
									"}",
									"pm.test(\"Successful root creation or already exists\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 500]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.node.create"
							],
							"query": [
								{
									"key": "treeName",
									"value": "{{treeName}}"
								},
								{
									"key": "nodeName",
									"value": "RootNode"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Child Node",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.environment.set(\"childNodeId\", jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.node.create"
							],
							"query": [
								{
									"key": "treeName",
									"value": "{{treeName}}"
								},
								{
									"key": "parentNodeId",
									"value": "{{rootNodeId}}"
								},
								{
									"key": "nodeName",
									"value": "ChildNode"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Rename Child Node",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.node.rename"
							],
							"query": [
								{
									"key": "nodeId",
									"value": "{{childNodeId}}"
								},
								{
									"key": "newNodeName",
									"value": "RenamedChild"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
