							"query": [
								{
									"key": "treeName",
									"value": "{{treeName}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "stt-004: Exception Journaling",
			"item": [
				{
					"name": "Get Single Journal Entry",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.test(\"Journal entry matches original error\", function () {",
									"    pm.expect(jsonData.eventId).to.eql(pm.environment.get(\"lastErrorEventId\"));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.journal.getSingle"
							],
							"query": [
								{
									"key": "id",
									"value": "{{lastErrorEventId}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Journal Range",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.test(\"Returns items\", function () {",
									"    pm.expect(jsonData.items).to.be.an('array');",
									"    pm.expect(jsonData.items.length).to.be.at.least(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.journal.getRange"
							],
							"query": [
								{
									"key": "skip",
									"value": "0"
								},
								{
									"key": "take",
									"value": "10"
								}
							],
							"body": {
								"mode": "raw",
								"raw": "{}",
								"options": {
									"json": {
										"language": "json"
									}
								}
							}
						}
					},
					"response": []
				}
			]
		}
	]
