		{
			"name": "stt-003: Recursive & Bulk Operations",
			"item": [
				{
					"name": "Delete Node (Safe - Should Fail)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 500\", function () {",
									"    pm.response.to.have.status(500);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.test(\"Error message matches safe deletion\", function () {",
									"    pm.expect(jsonData.data.message).to.contain(\"delete all children\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.node.delete"
							],
							"query": [
								{
									"key": "nodeId",
									"value": "{{rootNodeId}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Node (Forced)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.node.delete"
							],
							"query": [
								{
									"key": "nodeId",
									"value": "{{rootNodeId}}"
								},
								{
									"key": "isForcedDeletion",
									"value": "true"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Verify Empty Tree",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.test(\"Tree has no children\", function () {",
									"    pm.expect(jsonData.children).to.be.empty;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.get"
