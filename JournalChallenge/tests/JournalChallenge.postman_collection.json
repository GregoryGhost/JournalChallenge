									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": {
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api.user.tree.node.create"
							],
							"query": [
								{
									"key": "treeName",
									"value": "{{treeName}}"
								},
								{
									"key": "parentNodeId",
									"value": "{{rootNodeId}}"
								},
								{
									"key": "nodeName",
									"value": "RenamedChild"
								}
							]
						}
					},
					"response": []
