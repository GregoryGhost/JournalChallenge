			"item": [
				{
					"name": "Root Constraint (Duplicate Root)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 500\", function () {",
									"    pm.response.to.have.status(500);",
									"});",
									"const jsonData = pm.response.json();",
									"pm.test(\"Is SecureException\", function () {",
									"    pm.expect(jsonData.type).to.eql(\"Secure\");",
									"});",
									"pm.environment.set(\"lastErrorEventId\", jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
